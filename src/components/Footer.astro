  { key: "linkedin", url: SOCIAL.linkedin, label: "LinkedIn",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"/></svg>` },
  { key: "instagram", url: SOCIAL.instagram, label: "Instagram",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38 3.7 3.7 0 0 1-1.38.9c-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.86 5.86 0 0 0-2.13 1.38A5.86 5.86 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91a5.86 5.86 0 0 0 1.38 2.13 5.86 5.86 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 0 0 2.13-1.38 5.86 5.86 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 0 0-1.38-2.13A5.86 5.86 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>` },
  { key: "youtube", url: SOCIAL.youtube, label: "YouTube",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>` },
  { key: "mastodon", url: SOCIAL.mastodon, label: "Mastodon",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 8c0-4.7-3-6.1-3-6.1C17 1.2 14.6.9 12 .9h-.1c-2.7 0-5 .3-6.6 1.1 0 0-3 1.4-3 6 0 1.1 0 2.4.1 3.7.2 4.6.9 9.2 5.2 10.3 2 .5 3.7.7 5 .6 2.4-.1 3.7-.8 3.7-.8l-.1-1.7s-1.7.5-3.6.5c-1.9-.1-3.9-.2-4.2-2.5 0-.2 0-.4-.1-.6 0 0 1.9.5 4.3.6 1.5 0 2.9-.1 4.3-.3 2.7-.3 5.1-2 5.4-3.6.5-2.5.4-6.2.4-6.2zM18 13.5h-2.2V8.2c0-1.1-.5-1.7-1.4-1.7-1 0-1.6.7-1.6 1.9v2.7h-2.2V8.4c0-1.2-.5-1.9-1.6-1.9-1 0-1.4.6-1.4 1.7v5.3H5.4V8c0-1.1.3-2 .8-2.6.6-.6 1.4-1 2.3-1 1.1 0 1.9.4 2.5 1.3l.5.9.5-.9c.6-.9 1.4-1.3 2.5-1.3 1 0 1.7.4 2.3 1 .6.6.8 1.5.8 2.6v5.5z"/></svg>` },
  { key: "email", url: SOCIAL.email ? `mailto:${SOCIAL.email}` : "", label: "Email",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>` },
].filter((s) => s.url);
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div>© {year} {SITE.author}</div>
    {socials.length > 0 && (
      <div class="social">
        {socials.map((s) => (
          <a href={s.url} aria-label={s.label} title={s.label} target="_blank" rel="noopener">
            <Fragment set:html={s.icon} />
          </a>
        ))}
      </div>
    )}
    <div>
      <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a>
    </div>
  </div>
</footer>
